# Copy to .env for local dev (real .env is gitignored — NEVER commit real keys).
# In production these are set in the Railway dashboard's Variables tab, not here.

# Your hosted LNbits instance (no trailing slash).
LNBITS_URL=https://legend.lnbits.com

# The wallet's INVOICE/READ key (can create invoices + check status, cannot withdraw).
# NEVER use or deploy the Admin key.
LNBITS_INVOICE_KEY=paste_your_invoice_read_key_here

# Sats per rapid-fire purchase.
INVOICE_AMOUNT=21

# Allowed browser origin(s), comma-separated. Add your dev server while testing,
# e.g. https://developerofwebxr-oss.github.io,https://localhost:5173
ALLOWED_ORIGIN=https://developerofwebxr-oss.github.io

# Local dev port only — Railway injects PORT automatically in production.
PORT=8080

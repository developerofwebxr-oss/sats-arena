# Frontend (Vite) env. Copy to .env.local for local dev (.env.local is gitignored).
# Only VITE_-prefixed vars are exposed to the browser. No secrets here — the
# backend URL is public; the LNbits key lives only on the backend.

# Turn real Lightning on ("on") or leave off for the instant fake-grant fallback.
VITE_LIGHTNING=off

# Backend base URL (defaults to the live Railway service if unset).
VITE_BACKEND_URL=https://sats-arena-production.up.railway.app
